# Copy to .env for local dev (npx tsx loads .env automatically via --env-file, or use
# `export $(cat .env | xargs)` / your shell's own method). In production, set these as
# actual environment variables on whichever host runs api/server.ts — never commit real
# values, never put them in client-side code.

# --- Required ---

# Postgres connection string. Local dev: postgresql://app:PASSWORD@127.0.0.1:5432/elections_polling
# Production (Neon/Supabase): the connection string their dashboard gives you, including
# ?sslmode=require. db/connection.ts auto-enables SSL for anything not on localhost, so you
# don't strictly need sslmode=require in the string itself, but the providers include it anyway.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Shared secret for POST /api/ingest. Generate one with: openssl rand -hex 32
# Must be set identically here and in the GitHub Actions workflow's INGEST_SECRET repo secret
# (or wherever else triggers ingestion). Without this set, /api/ingest refuses all requests.
INGEST_SECRET=

# Comma-separated list of origins allowed to call this API from a browser (the deployed
# map's actual domain). Example: https://senate-map.example.com
# Without this set, no cross-origin browser request will succeed (server-to-server calls,
# like the GitHub Actions cron hitting /api/ingest, aren't affected — CORS only governs
# browsers).
ALLOWED_ORIGINS=

# --- Optional (sensible defaults already in code) ---

# Port api/server.ts listens on. Most hosts (Render, Railway, Fly) inject their own PORT —
# leave unset and let the platform set it, unless running locally.
PORT=4001

# Max Postgres connections this process opens. Keep this low — free-tier managed Postgres
# (Neon free tier: ~computed by their pooler, commonly single digits per branch without
# connection pooling enabled) caps total concurrent connections fairly aggressively, and
# both the API and the scheduler (if you run scheduler-daemon.ts instead of GitHub Actions)
# would each open their own pool.
DB_POOL_MAX=5

# Minimum time between two POST /api/ingest calls, regardless of auth — a safety net so a
# leaked secret or a misconfigured cron can't hammer Emerson's site.
MIN_INGEST_INTERVAL_MS=60000

# Delay between each per-state fetch within a single ingestion pass — a courtesy to the
# source, not a requirement Emerson states anywhere.
INGEST_INTER_RACE_DELAY_MS=400

# Only used if you run ingestion/scheduler-daemon.ts as an always-on process instead of the
# recommended GitHub Actions cron (see DEPLOYMENT.md "Scheduler" for the tradeoff).
INGEST_INTERVAL_MS=1800000
